# Copy to .env and fill in. Variables already set in your shell take precedence.

# Gemini API key, get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key

# Or read it from a password manager: a value starting with "!" is run as a
# shell command and replaced by its output.
# GEMINI_API_KEY="!op read 'op://Vault/Gemini API Key/credential'"

# Model to use (default gemini-nano-banana-2.1)
# GEMINI_MODEL=gemini-3-pro-image

# Default image format (overridable with --aspect-ratio / --size)
# GEMINI_ASPECT_RATIO=16:9
# GEMINI_SIZE=2K

# Show the image in the terminal (kitty graphics protocol), default true
# GEMINI_PREVIEW=false
